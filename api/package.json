{
  "name": "@brewhaus/api",
  "version": "0.1.0",
  "description": "BrewHaus serverless API (Azure Functions v4, Node programming model)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --external:@azure/functions-core --outfile=dist/index.js",
    "start": "func start"
  },
  "dependencies": {
    "@azure/cosmos": "^4.1.0",
    "@azure/functions": "^4.6.0",
    "@brewhaus/core": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
